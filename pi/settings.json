{
  "theme": "gruvbox-light/cobalt2",
  "extensions": [
    "~/my-pi-skills/extensions/azure-foundry.ts",
    "~/my-pi-skills/extensions/azure-openai-models.ts",
    "~/my-pi-skills/extensions/valar-dynamic.ts",
    "~/my-pi-skills/extensions/herdr-agent-state.ts",
    "~/my-pi-skills/extensions/lifecycle-guards"
  ],
  "lastChangelogVersion": "1.2.0",
  "defaultProvider": "valar",
  "defaultModel": "moonshotai/Kimi-K3",
  "hideThinkingBlock": true,
  "defaultThinkingLevel": "high",
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "compaction": {
    "reserveTokens": 32768
  },
  "packages": [
    "npm:@mnemosyne-oss/pi-mnemosyne",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-subagents"
  ],
  "enableSkillCommands": true,
  "enabledModels": [
    "valar/moonshotai/Kimi-K3-fast",
    "valar/qwen/qwen3.8-max",
    "valar/zai-org/GLM-5.3",
    "azure-claude/claude-opus-5",
    "azure-claude/claude-sonnet-5"
  ],
  "skills": [
    "~/my-pi-skills/skills"
  ],
  "themes": [
    "~/my-pi-skills/themes"
  ]
}
