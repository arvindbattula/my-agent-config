{
  "theme": "light",
  "extensions": [
    "~/.pi/agent/extensions/azure-foundry.ts",
    "~/.pi/agent/extensions/azure-openai-models.ts"
  ],
  "lastChangelogVersion": "1.4.0",
  "defaultProvider": "valar",
  "defaultModel": "zai-org/GLM-5.3",
  "hideThinkingBlock": false,
  "defaultThinkingLevel": "high",
  "retry": {
    "enabled": false,
    "provider": {
      "maxRetries": 2
    }
  },
  "compaction": {
    "reserveTokens": 32768
  },
  "packages": [
    "npm:@luxusai/pi-hindsight"
  ],
  "defaultTools": [
    "+codemode"
  ]
}